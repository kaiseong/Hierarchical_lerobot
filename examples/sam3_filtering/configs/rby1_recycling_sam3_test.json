{
  "description": "Phase-0 SAM3 prompt/BBOX segmentation test for RB-Y1 pi0.5 recycling demo. Edit dataset keys and BBOX values before running on the 5090/Thor machine.",
  "dataset": {
    "repo_id": "kaiseong/rby1-recycling-demo",
    "root": null,
    "episodes": [
      0
    ],
    "camera_keys": {
      "front": "observation.images.front",
      "left_wrist": "observation.images.left",
      "right_wrist": "observation.images.right"
    }
  },
  "sam3": {
    "confidence_threshold": 0.3,
    "device": "cuda",
    "dtype": "bfloat16",
    "mask_dilation_px": 12,
    "background_value": 0,
    "max_instances_per_role": 3,
    "fail_on_required_missing": false
  },
  "cameras": {
    "front": {
      "roles": [
        {
          "name": "can_object",
          "prompts": [
            "can"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "pet_object",
          "prompts": [
            "bottle"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "can_bin",
          "prompts": [
            "grey container"
          ],
          "optional": false,
          "search_regions": [
            {
              "format": "normalized_xyxy",
              "value": [
                0.15,
                0.0,
                0.85,
                0.45
              ]
            }
          ],
          "restrict_to_search_region": false
        },
        {
          "name": "pet_bin",
          "prompts": [
            "yellow container"
          ],
          "optional": false,
          "search_regions": [
            {
              "format": "normalized_xyxy",
              "value": [
                0.15,
                0.0,
                0.85,
                0.45
              ]
            }
          ],
          "restrict_to_search_region": false
        },
        {
          "name": "robot_arm_gripper",
          "prompts": [
            "robot"
          ],
          "optional": false,
          "max_instances": 5
        }
      ]
    },
    "left_wrist": {
      "notes": "Wrist camera view changes with arm motion. Gripper uses broad lower BBOX+prompt; bins are prompt-only and optional because they may be out of view.",
      "roles": [
        {
          "name": "can_object",
          "prompts": [
            "can"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "pet_object",
          "prompts": [
            "bottle"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "can_bin",
          "prompts": [
            "grey container"
          ],
          "optional": true,
          "max_instances": 2
        },
        {
          "name": "pet_bin",
          "prompts": [
            "yellow container"
          ],
          "optional": true,
          "max_instances": 2
        },
        {
          "name": "robot_gripper",
          "prompts": [
            "blue holder"
          ],
          "optional": false,
          "boxes": [
            {
              "label": true,
              "format": "normalized_xyxy",
              "value": [
                0.0,
                0.5,
                1.0,
                1.0
              ],
              "note": "Broad lower-half gripper prior for wrist camera."
            }
          ],
          "max_instances": 3
        }
      ]
    },
    "right_wrist": {
      "notes": "Same policy as left_wrist; adjust gripper BBOX if the right wrist camera sees the fingers in a different region.",
      "roles": [
        {
          "name": "can_object",
          "prompts": [
            "can"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "pet_object",
          "prompts": [
            "bottle"
          ],
          "optional": false,
          "max_instances": 3
        },
        {
          "name": "can_bin",
          "prompts": [
            "grey container"
          ],
          "optional": true,
          "max_instances": 2
        },
        {
          "name": "pet_bin",
          "prompts": [
            "yellow container"
          ],
          "optional": true,
          "max_instances": 2
        },
        {
          "name": "robot_gripper",
          "prompts": [
            "blue holder"
          ],
          "optional": false,
          "boxes": [
            {
              "label": true,
              "format": "normalized_xyxy",
              "value": [
                0.0,
                0.5,
                1.0,
                1.0
              ],
              "note": "Broad lower-half gripper prior for wrist camera."
            }
          ],
          "max_instances": 3
        }
      ]
    }
  }
}
